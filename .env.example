# No API keys are required for local sample workflows.
# Future secrets belong only in .env.local. Never commit real credentials.
# MOCK_MODE=true
# MAX_UPLOAD_BYTES=2147483648
# FFMPEG_PATH=optional-path-to-ffmpeg
# FFPROBE_PATH=optional-path-to-ffprobe
# Optional absolute runtime data directory; default is the app source directory.
# Start web and worker with the same value, keeping their cwd in the source.
# DREAM_DATA_ROOT=D:/MyRestoredStudio

# 로그인(Supabase). 이 PC 전용 실행은 기본으로 로그인을 쓰지 않아요.
# DREAM_AUTH_MODE=supabase 이거나 Vercel에서 실행하면 모든 화면·API에 로그인이 필요해요.
# DREAM_AUTH_MODE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 비밀: 서버·작업 처리기 전용. 화면 코드와 저장소에 절대 넣지 않아요.
# SUPABASE_SERVICE_ROLE_KEY=
# 로그인을 허용할 이메일(쉼표로 여러 개)
# DREAM_ALLOWED_EMAILS=
