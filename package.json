{
  "name": "dream-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-reference-media.mjs",
    "build": "next build && node scripts/verify-build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/main.ts",
    "dev:all": "concurrently --kill-others --success all --names web,worker \"npm run dev\" \"npm run worker\"",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db.ts migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/db.ts seed"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "file-type": "22.3.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "yauzl": "3.4.0",
    "zip-stream": "7.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/zip-stream": "7.0.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
